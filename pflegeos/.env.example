# ============================================================
# PflegeOS — Environment Variables
# Kopiere diese Datei nach .env und fülle die Werte aus
# ============================================================

# Flask
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=AENDERN_SIE_DIESEN_SCHLUESSEL_VOR_PRODUKTION

# Datenbank PostgreSQL
DATABASE_URL=postgresql://pflegeos:pflegeos_passwort@localhost:5432/pflegeos_db

# Verschlüsselung (Fernet-Key — generieren: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ENCRYPTION_KEY=HIER_FERNET_KEY_EINTRAGEN

# Uploads
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=16777216

# E-Mail (optional für MVP)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=1
MAIL_USERNAME=ihre@email.de
MAIL_PASSWORD=ihr_app_passwort

# Anthropic API (für KI-Assistent — anonym)
ANTHROPIC_API_KEY=sk-ant-...

# Session
SESSION_COOKIE_SECURE=0
SESSION_COOKIE_HTTPONLY=1
SESSION_COOKIE_SAMESITE=Lax
PERMANENT_SESSION_LIFETIME=28800
