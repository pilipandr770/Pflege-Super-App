# ============================================================
# PflegeOS — Umgebungsvariablen
# Kopieren:  cp .env.example .env   und Werte eintragen
# ============================================================

# ── Flask ────────────────────────────────────────────────────
SECRET_KEY=bitte-aendern-mindestens-32-zeichen-lang
FLASK_ENV=development

# ── Datenbank ────────────────────────────────────────────────
# Im Docker-Compose automatisch überschrieben (db-Service).
# Für lokales Starten ohne Docker:
DATABASE_URL=postgresql+psycopg://pflegeos:pflegeos_passwort@localhost:5432/pflegeos_db

# ── E-Mail ───────────────────────────────────────────────────
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=1
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=noreply@pflegeos.de

# ── KI-Funktionen (Anthropic Claude) ─────────────────────────
ANTHROPIC_API_KEY=

# ── Stripe (Abonnement / Zahlungen) ──────────────────────────
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
STRIPE_PLAN_AMOUNT=25000
STRIPE_PLAN_CURRENCY=eur
STRIPE_PLAN_NAME=PflegeOS Professional

# ── Uploads ──────────────────────────────────────────────────
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=16777216
